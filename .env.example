# ── Server di VPS (dibaca oleh docker compose) ───────────────────────────
# Salin menjadi .env lalu isi. File .env TIDAK boleh di-commit.

# Domain API. DNS (A record) harus sudah mengarah ke IP VPS sebelum start,
# agar Caddy bisa mengambil sertifikat HTTPS.
API_DOMAIN=api-pawai.toolkitbps.my.id

# Origin web admin yang boleh memanggil API, dipisah koma. "*" = wildcard.
# Web admin production: https://pawai.toolkitbps.my.id (Vercel).
CORS_ORIGINS=https://pawai.toolkitbps.my.id,https://pantau-pegawai-v2.vercel.app,http://localhost:*

# Password database. Pakai huruf & angka saja (dipakai di URL koneksi).
# Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=

# ID folder Google Drive tempat foto disimpan (sama dengan sebelumnya).
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Upload foto atas nama akun Gmail pemilik folder di atas. Wajib bila folder
# ada di My Drive Gmail biasa: service account tidak punya kuota penyimpanan
# (403 storageQuotaExceeded). Client ID/secret dari OAuth client tipe
# "Desktop app"; refresh token dari:
#   docker compose run --rm api node dist/scripts/google-oauth-login.js
# Lihat docs/13-deploy-vps.md bagian "Upload foto ke Drive Gmail biasa".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# API key Google Sheets: untuk menu Import Data, ./sync.sh, dan ./run_local.sh.
GOOGLE_SHEETS_API_KEY=

# Zona waktu kantor untuk "hari ini" di dashboard.
APP_TIMEZONE=Asia/Makassar

# Lama backup harian disimpan (hari).
BACKUP_KEEP_DAYS=7

# ── Pengembangan aplikasi Flutter (dibaca oleh ./run_local.sh) ───────────
# URL API yang dipakai aplikasi saat dijalankan lokal.
API_URL=http://localhost:3000
